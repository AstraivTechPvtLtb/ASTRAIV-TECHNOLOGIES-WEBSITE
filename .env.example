# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Analytics 4 Measurement ID
# Found in Google Analytics Admin > Data Streams > Web Stream Details (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Database Connection
DATABASE_URL=postgresql://postgres:password@localhost:5432/astraiv_db

# Supabase Storage (Optional)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Authentication Secrets (generate random 64-character hex strings in production)
BETTER_AUTH_SECRET=your_better_auth_secret_key_here
JWT_SECRET=your_jwt_secret_min_64_chars_here
JWT_ACCESS_EXPIRES_IN=60d
JWT_REFRESH_EXPIRES_IN=30d
