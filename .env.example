# ==============================================================================
# Astraiv Technologies — Client Application Environment Configuration
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or actual production credentials to version control.

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Analytics 4 Measurement ID (Web Stream)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Database Connection (Prisma & pg Adapter)
# Local development: Point to your isolated local PostgreSQL instance
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/astraiv_dev?schema=public
# Direct connection for migrations/CLI (optional for local dev)
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/astraiv_dev?schema=public

# Supabase Cloud Fallback & Storage (Optional for local dev)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Client Authentication & Session Security
# Generate independent 64-character random hex strings for development:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=your_better_auth_secret_min_32_chars_here
BETTER_AUTH_URL=http://localhost:3000
JWT_SECRET=your_jwt_secret_min_64_chars_here
JWT_ACCESS_EXPIRES_IN=60d
JWT_REFRESH_EXPIRES_IN=30d
LEAD_SESSION_SECRET=your_lead_session_secret_min_64_chars_here

# Cross-Application Cache Revalidation Secret
# MUST match REVALIDATE_SECRET in the Admin application (.env.local)
REVALIDATE_SECRET=your_shared_revalidate_secret_min_32_chars_here

# Google Form Review Sync Webhook Secret
GOOGLE_FORM_WEBHOOK_SECRET=your_form_webhook_secret_here

# Email Services (Resend — optional for local dev)
RESEND_API_KEY=re_123456789_placeholder

# Optional External Email Deliverability Provider
EMAIL_VALIDATION_PROVIDER=abstract
EMAIL_VALIDATION_API_KEY=your_email_validation_api_key_here
