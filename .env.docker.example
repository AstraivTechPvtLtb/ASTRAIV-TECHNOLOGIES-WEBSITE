# ==============================================================================
# Astraiv Technologies — Client Website Docker Environment Template
# ==============================================================================
# Copy this file to .env.docker (or inject via docker compose / Docker run).
# NEVER commit production passwords, tokens, or secret keys to version control.
# In production, inject these via secure secrets management or Linux environment.
# ==============================================================================

# --- Application Runtime Networking ---
PORT=3000
HOSTNAME=0.0.0.0
# Browser-facing canonical origin (local testing: http://localhost:3000, production: https://www.astraivtechnologies.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Telemetry & Analytics ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_TELEMETRY_DISABLED=1

# --- Supabase PostgreSQL Database (Prisma ORM with pg adapter) ---
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?sslmode=require
DATABASE_URL=postgresql://postgres.your-supabase-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# --- Supabase Public Storage & Media CMS ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- Client Portal Authentication & Session Cryptography ---
# Generate 64-char hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=your_better_auth_secret_minimum_32_characters
BETTER_AUTH_URL=http://localhost:3000
JWT_SECRET=your_jwt_signing_secret_minimum_64_characters
JWT_ACCESS_EXPIRES_IN=60d
JWT_REFRESH_EXPIRES_IN=30d
LEAD_SESSION_SECRET=your_lead_session_secret_minimum_64_characters

# --- Cross-Application Cache Invalidation ---
# Must exactly match REVALIDATE_SECRET in the Admin dashboard
REVALIDATE_SECRET=your_shared_revalidate_secret_minimum_32_characters

# --- Form Webhooks ---
GOOGLE_FORM_WEBHOOK_SECRET=your_form_sync_secret_here

# --- Email Notifications (Resend) ---
RESEND_API_KEY=re_placeholder_api_key_here

# --- Cloudflare R2 Private Candidate Resume Storage ---
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_RESUME_BUCKET_NAME=astraiv-candidate-resumes
NEXT_PUBLIC_R2_CDN_URL=https://cdn.astraiv.com

# --- Optional Stripe Billing Configuration ---
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
